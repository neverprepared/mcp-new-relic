{
  "name": "@neverprepared/mcp-new-relic",
  "version": "0.1.2",
  "description": "MCP server for New Relic NerdGraph GraphQL API",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-new-relic": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
